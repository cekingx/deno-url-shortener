{
  "imports": {
    "@da/bcrypt": "jsr:@da/bcrypt@^1.0.1",
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@std/expect": "jsr:@std/expect@^1.0.19",
    "hono": "jsr:@hono/hono@^4.12.21",
    "jose": "npm:jose@^6.2.3"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env --env-file --allow-ffi main.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --env-file main.ts",
    "add-user": "deno run --allow-read --allow-write --allow-env --env-file scripts/add-user.ts",
    "test": "deno test",
    "tw:watch": "npx @tailwindcss/cli -i ./src/input.css -o ./static/tailwind.css --watch",
    "tw:build": "npx @tailwindcss/cli -i ./src/input.css -o ./static/tailwind.css --minify"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  }
}
